{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Deny-by-default: only permit explicitly listed IPC commands",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:tray:default",
    {
      "identifier": "core:event:allow-emit",
      "allow": [{ "event": "runtime-signal" }]
    },
    {
      "identifier": "core:event:allow-listen",
      "allow": [{ "event": "runtime-signal" }]
    }
  ]
}
